/target

# Node modules (created during grammar regeneration)
node_modules/
**/node_modules/

# Generated grammar C sources (regenerated by `cargo xtask gen`)
# Note: scanner.c is NOT ignored - it's handwritten and should be in git
crates/*/grammar-src/parser.c
crates/*/grammar-src/grammar.json
crates/*/grammar-src/node-types.json
crates/*/grammar-src/tree_sitter/

# Pre-compressed demo files
demo/*.br
demo/*.gz
